PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
# Approved browser origins; overrides FRONTEND_URL when set. No wildcard.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Example only. Replace these placeholders in your ignored .env file.
DATABASE_URL="postgresql://DB_USER:REPLACE_WITH_PASSWORD@localhost:5432/worker_booking?schema=public"

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Business calendar for completion-based earnings.
APP_TIMEZONE=Asia/Kolkata

# Example placeholders only. Set real values in ignored backend/.env.
# Admin creation is explicit: npm run admin:create
ADMIN_NAME=Platform Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PHONE=9999999999
ADMIN_PASSWORD=change-this-secure-password
